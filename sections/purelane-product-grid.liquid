{{ 'purelane.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<section class="pl-section pl-products" id="shop" data-scene="3">
  <div class="pl-shell">
    <header class="pl-section-head">
      <div><span class="pl-kicker">{{ section.settings.kicker | escape }}</span><h2 class="pl-heading">{{ section.settings.heading | escape }}</h2></div>
      <p class="pl-copy">{{ section.settings.copy | escape }}</p>
    </header>

    <div class="pl-product-grid">
      {% assign shown_products = 0 %}
      {% for product in section.settings.collection.products %}
        {% if product.type != 'Bundle' and shown_products < section.settings.limit %}
          {% liquid
            assign badge = product.metafields.custom.card_badge.value
            if badge == blank and product.tags contains 'best-seller'
              assign badge = 'Best seller'
            elsif badge == blank and product.tags contains 'top-rated'
              assign badge = 'Top rated'
            elsif badge == blank and product.tags contains 'new'
              assign badge = 'New'
            endif
            assign benefit = product.metafields.custom.short_benefit.value | default: product.description | strip_html | truncatewords: 13
          %}
          {% render 'purelane-product-card', product: product, badge: badge, benefit: benefit, section_id: section.id %}
          {% assign shown_products = shown_products | plus: 1 %}
        {% endif %}
      {% else %}
        {% for i in (1..4) %}<article class="pl-product-card"><div class="pl-product-card__media">{{ 'product-' | append: i | placeholder_svg_tag }}</div><div class="pl-product-card__body"><h3>Select a collection</h3><p>Products, prices and availability will come from Shopify.</p></div></article>{% endfor %}
      {% endfor %}
    </div>
    <div class="pl-range pl-glass pl-reveal"><div><span class="pl-kicker">The full range</span><h2 class="pl-heading">Every room, one shelf</h2></div><p class="pl-copy">Floors, taps, kitchen, laundry, bathroom and hands. Plant-based formulas for the whole home.</p><div class="pl-range__products">{% assign range_count = 0 %}{% for product in section.settings.collection.products %}{% if product.type != 'Bundle' and product.featured_image and range_count < 10 %}{{ product.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: product.title }}{% assign range_count = range_count | plus: 1 %}{% endif %}{% endfor %}</div></div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane product grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Real products, live prices and availability—straight from Shopify." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Purelane product grid" }]
}
{% endschema %}
