{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section class="pl-section pl-story" id="how" data-scene="2" data-pl-depth="2">
  <div class="pl-shell pl-pillar-grid">
    {% for block in section.blocks %}<article class="pl-story-card pl-glass pl-reveal" {{ block.shopify_attributes }}><span class="pl-story-card__icon">{% cycle '♧','♢','♡' %}</span><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.copy | escape }}</p><a class="pl-button pl-button--outline" href="{{ block.settings.link | default: '#shop' }}">Learn more</a></article>{% endfor %}
  </div>
</section>

<section class="pl-section pl-proof" id="proof" data-scene="3" data-pl-depth="3">
  <div class="pl-shell"><div class="pl-proof__panel pl-glass pl-reveal">
    <div><span class="pl-kicker">{{ section.settings.kicker | escape }}</span><h2 class="pl-heading">{{ section.settings.proof_heading | newline_to_br }}</h2><p class="pl-copy">{{ section.settings.proof_copy | escape }}</p><a class="pl-button pl-button--primary" href="#ingredients">See the ingredient list →</a></div>
    {% assign proof_product = section.settings.product %}<div class="pl-proof__product pl-glass">{% if proof_product.featured_image %}{{ proof_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: proof_product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}<b>{{ proof_product.title | default: 'Kitchen cleaner' }}</b><span>Foam lifts grease, no scrubbing</span></div>
    <div class="pl-proof__stats">{% for i in (1..4) %}{% assign value_key = 'stat_' | append: i %}{% assign label_key = 'stat_label_' | append: i %}<div><strong>{{ section.settings[value_key] }}</strong><b>{{ section.settings[label_key] }}</b></div>{% endfor %}</div>
  </div></div>
</section>

{% schema %}
{
  "name": "Purelane story and proof", "tag": "section", "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Proof kicker", "default": "Why it works" },
    { "type": "textarea", "id": "proof_heading", "label": "Proof heading", "default": "Tough on grime.\nGentle on everything else." },
    { "type": "textarea", "id": "proof_copy", "label": "Proof copy", "default": "Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for." },
    { "type": "product", "id": "product", "label": "Proof product" },
    { "type": "text", "id": "stat_1", "label": "Stat 1", "default": "99.9%" }, { "type": "text", "id": "stat_label_1", "label": "Stat 1 label", "default": "Germ kill" },
    { "type": "text", "id": "stat_2", "label": "Stat 2", "default": "0%" }, { "type": "text", "id": "stat_label_2", "label": "Stat 2 label", "default": "Sulphates" },
    { "type": "text", "id": "stat_3", "label": "Stat 3", "default": "100%" }, { "type": "text", "id": "stat_label_3", "label": "Stat 3 label", "default": "Plant based" },
    { "type": "text", "id": "stat_4", "label": "Stat 4", "default": "4.8" }, { "type": "text", "id": "stat_label_4", "label": "Stat 4 label", "default": "Rated" }
  ],
  "blocks": [{ "type": "pillar", "name": "Benefit", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Less scrubbing" }, { "type": "textarea", "id": "copy", "label": "Copy", "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub." }, { "type": "url", "id": "link", "label": "Link" }] }],
  "max_blocks": 3,
  "presets": [{ "name": "Purelane story and proof", "blocks": [{ "type": "pillar" }, { "type": "pillar", "settings": { "heading": "Clean ingredients", "copy": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food." } }, { "type": "pillar", "settings": { "heading": "Safe around everyone", "copy": "Gentle on hands, safe around kids and pets, with no toxic residue on everyday surfaces." } }] }]
}
{% endschema %}
