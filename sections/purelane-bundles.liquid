{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section class="pl-section pl-bundles" id="bundles" data-scene="3">
  <div class="pl-shell">
    <header class="pl-bundles__head pl-glass pl-reveal">
      <span class="pl-kicker">{{ section.settings.kicker | escape }}</span><h2 class="pl-heading">{{ section.settings.heading | escape }}</h2><p class="pl-copy">{{ section.settings.copy | escape }}</p>
    </header>

    <div class="pl-tier-grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        <article class="pl-tier" data-featured="{{ block.settings.featured }}" {{ block.shopify_attributes }}>
          <span class="pl-tier__tag">{{ block.settings.eyebrow | escape }}</span>
          <div class="pl-tier__image" aria-hidden="true">
            {% if block.settings.quantity == 2 %}
              {% render 'purelane-product-art', kind: 'kitchen' %}{% render 'purelane-product-art', kind: 'tap' %}
            {% elsif block.settings.quantity == 3 %}
              {% render 'purelane-product-art', kind: 'kitchen' %}{% render 'purelane-product-art', kind: 'tap' %}{% render 'purelane-product-art', kind: 'dish' %}
            {% else %}
              {% render 'purelane-product-art', kind: 'kitchen' %}{% render 'purelane-product-art', kind: 'tap' %}{% render 'purelane-product-art', kind: 'floor' %}{% render 'purelane-product-art', kind: 'toilet' %}{% render 'purelane-product-art', kind: 'laundry' %}
            {% endif %}
          </div>
          <h3>{{ block.settings.quantity }}<small>Products</small></h3>
          <div class="pl-tier__offer"><span class="pl-tier__price">{{ block.settings.price }}</span><s>{{ block.settings.compare_price }}</s></div>
          <small class="pl-tier__per">{{ block.settings.per_product | escape }}</small>
          <ul><li>{{ block.settings.feature_1 | escape }}</li><li>{{ block.settings.feature_2 | escape }}</li>{% if block.settings.feature_3 != blank %}<li>{{ block.settings.feature_3 | escape }}</li>{% endif %}</ul>
          <a class="pl-button {% if block.settings.featured %}pl-button--primary{% else %}pl-button--outline{% endif %}" href="{{ product.url | default: '#shop' }}">Build this box{% if block.settings.featured %} &rarr;{% endif %}</a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane bundles",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way." }
  ],
  "blocks": [{
    "type": "tier", "name": "Bundle tier", "settings": [
      { "type": "product", "id": "product", "label": "Bundle product" },
      { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Starter" },
      { "type": "range", "id": "quantity", "label": "Number of products", "min": 1, "max": 10, "step": 1, "default": 2 },
      { "type": "text", "id": "heading", "label": "Fallback heading", "default": "Pick any two" },
      { "type": "text", "id": "price", "label": "Fallback price", "default": "₹349" },
      { "type": "text", "id": "compare_price", "label": "Compare-at price", "default": "₹598" },
      { "type": "text", "id": "per_product", "label": "Per-product note", "default": "Flat ₹174 per product" },
      { "type": "text", "id": "feature_1", "label": "Feature 1", "default": "Choose your favourites" },
      { "type": "text", "id": "feature_2", "label": "Feature 2", "default": "One flat price" },
      { "type": "text", "id": "feature_3", "label": "Feature 3", "default": "Free shipping" },
      { "type": "checkbox", "id": "featured", "label": "Feature this tier", "default": false }
    ]
  }],
  "max_blocks": 3,
  "presets": [{ "name": "Purelane bundles", "blocks": [{ "type": "tier" }, { "type": "tier", "settings": { "eyebrow": "Most popular", "heading": "Pick any three", "price": "₹499", "featured": true } }, { "type": "tier", "settings": { "eyebrow": "Best value", "heading": "Pick any five", "price": "₹799" } }] }]
}
{% endschema %}
