{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section class="pl-section pl-reviews" id="reviews">
  <div class="pl-review-head">
    <span class="pl-kicker">{{ section.settings.kicker | escape }}</span>
    <span class="pl-review-head__stat"><span aria-hidden="true">★★★★★</span> <b>{{ section.settings.rating | escape }}</b> {{ section.settings.review_count | escape }}</span>
    <span class="pl-review-head__stat">Loved by <b>{{ section.settings.homes | escape }}</b> homes</span>
  </div>
  <div class="pl-review-viewport">
    <div class="pl-review-track" aria-label="Customer reviews">
      {% for repeat in (1..2) %}{% for block in section.blocks %}
        <article class="pl-review" {% if repeat == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
          <div class="pl-review__stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for star in (1..5) %}{% if star <= block.settings.rating %}★{% else %}☆{% endif %}{% endfor %}</div>
          <h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.review | escape }}</p>
          <footer><span aria-hidden="true">✓</span> {{ block.settings.customer | escape }}{% if block.settings.product != blank %} · {{ block.settings.product.title | escape }}{% endif %}</footer>
        </article>
      {% endfor %}{% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "That's what they said" },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "from 8,000+ reviews" },
    { "type": "text", "id": "homes", "label": "Homes", "default": "12 lakh+" }
  ],
  "blocks": [{
    "type": "review", "name": "Review", "settings": [
      { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "text", "id": "title", "label": "Title", "default": "Works like a charm" },
      { "type": "textarea", "id": "review", "label": "Review", "default": "Finally an eco option that cleans as well as the chemical cleaner I used for years." },
      { "type": "text", "id": "customer", "label": "Customer", "default": "Verified buyer" },
      { "type": "product", "id": "product", "label": "Related product" }
    ]
  }],
  "max_blocks": 8,
  "presets": [{ "name": "Purelane reviews", "blocks": [{ "type": "review", "settings": { "customer": "Anita" } }, { "type": "review", "settings": { "title": "Best dishwash ever", "customer": "Priya" } }, { "type": "review", "settings": { "title": "Great product, great packaging", "customer": "Sunita" } }, { "type": "review", "settings": { "title": "Dog friendly", "customer": "Rohit S." } }] }]
}
{% endschema %}
