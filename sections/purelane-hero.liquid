{{ 'purelane.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane.js' | asset_url }}" defer="defer"></script>

<div class="scenes" id="scenes" data-d="1" aria-hidden="true">
  <div class="scene s1 on"></div>
  <div class="scene s2"></div>
  <div class="scene s3"></div>
  <div class="scene s4"></div>
  <div class="water" id="water">
    <div class="wl wl-a"></div>
    <div class="wl wl-b"></div>
    <div class="wl wl-c"></div>
    <div class="wl wl-s"></div>
    <div class="bub">
      <span style="--x:91.9%;--s:6.7px;--dur:21.5s;--dly:19.0s;--drift:-11px"></span>
      <span style="--x:43.4%;--s:5.7px;--dur:26.8s;--dly:16.1s;--drift:-11px"></span>
      <span style="--x:96.6%;--s:6.2px;--dur:13.7s;--dly:10.3s;--drift:38px"></span>
      <span style="--x:6.0%;--s:3.6px;--dur:24.4s;--dly:10.6s;--drift:3px"></span>
      <span style="--x:70.3%;--s:3.3px;--dur:20.9s;--dly:9.2s;--drift:-39px"></span>
      <span style="--x:67.7%;--s:4.0px;--dur:27.0s;--dly:16.5s;--drift:-5px"></span>
      <span style="--x:2.1%;--s:7.1px;--dur:22.0s;--dly:3.1s;--drift:-37px"></span>
      <span style="--x:69.4%;--s:8.1px;--dur:21.9s;--dly:10.7s;--drift:-24px"></span>
      <span style="--x:64.1%;--s:8.2px;--dur:17.3s;--dly:9.0s;--drift:2px"></span>
      <span style="--x:21.8%;--s:7.1px;--dur:15.7s;--dly:18.4s;--drift:-13px"></span>
      <span style="--x:61.9%;--s:6.6px;--dur:26.3s;--dly:7.2s;--drift:-23px"></span>
      <span style="--x:45.9%;--s:8.9px;--dur:24.3s;--dly:7.2s;--drift:20px"></span>
      <span style="--x:52.5%;--s:3.3px;--dur:20.2s;--dly:19.6s;--drift:-31px"></span>
      <span style="--x:11.1%;--s:7.9px;--dur:20.4s;--dly:10.8s;--drift:-40px"></span>
      <span style="--x:7.6%;--s:6.4px;--dur:19.5s;--dly:0.2s;--drift:-26px"></span>
      <span style="--x:18.6%;--s:9.0px;--dur:24.5s;--dly:8.7s;--drift:13px"></span>
    </div>
  </div>
  <div class="vig"></div>
</div>

<nav class="rail" aria-label="Section progress">
  <a href="#top" class="on" aria-label="Hero"></a>
  <a href="#ingredients" aria-label="Ingredients"></a>
  <a href="#how" aria-label="How it works"></a>
  <a href="#proof" aria-label="Proof"></a>
  <a href="#bundles" aria-label="Bundles"></a>
  <a href="#shop" aria-label="Shop"></a>
  <a href="#reviews" aria-label="Reviews"></a>
</nav>

<div class="pl-ticker" aria-hidden="true">
  <div class="pl-ticker__track">
    {% for repeat in (1..2) %}
      <span>Free shipping <b>on every bundle across India</b></span>
      <span>100% plant-based <b>and non-toxic</b></span>
      <span>Loved by <b>30,000+ happy homes</b></span>
      <span>Buy 3 <b>at flat &#8377;499</b></span>
    {% endfor %}
  </div>
</div>

<header class="pl-header" id="hdr">
  <div class="pl-navpill pl-glass">
    <a class="pl-brand" href="#top" aria-label="Purelane home">
      <span class="pl-brand__mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/><path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/></svg>
      </span>
      <span><b>Purelane</b><small>Clean, simply</small></span>
    </a>
    <nav class="pl-nav" aria-label="Main navigation">
      <a href="#top">Home</a><a href="#ingredients">Ingredients</a><a href="#how">How it works</a><a href="#shop">Shop</a><a href="#bundles">Bundles</a>
    </nav>
    <div class="pl-navtools">
      <a href="{{ routes.search_url }}" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></a>
      <a href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/></svg></a>
      <a href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/><circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/></svg><span>{{ cart.item_count }}</span></a>
    </div>
  </div>
</header>

{% for featured_product in section.settings.products %}
  {% case forloop.index %}
    {% when 1 %}{% assign p1 = featured_product %}
    {% when 2 %}{% assign p2 = featured_product %}
    {% when 3 %}{% assign p3 = featured_product %}
  {% endcase %}
{% endfor %}

<section class="pl-section hero" id="top" data-scene="1">
  <div class="hero-grid">
    <div class="badges glass-2" aria-label="Product promises">
      {% for block in section.blocks %}
        <div class="badge" {{ block.shopify_attributes }}>
          <span class="bi">{% case forloop.index %}{% when 1 %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>{% when 2 %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>{% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>{% endcase %}</span>
          <span>{{ block.settings.text | escape | replace: ' ', '<br>' }}</span>
        </div>
      {% endfor %}
    </div>

    <div class="hero-copy">
      <h1 class="d1 rv in">{{ section.settings.heading | newline_to_br }}<br><span class="lime">{{ section.settings.accent_heading | escape }}</span></h1>
      <div class="rule rv rv-d1"><i></i><span aria-hidden="true">&#9827;</span><i></i></div>
      <p class="lede rv rv-d2">{{ section.settings.copy | escape }}</p>
      <div class="hero-cta rv rv-d3">
        {% if section.settings.primary_label != blank %}<a class="btn btn-primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }} <span aria-hidden="true">&#8594;</span></a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="btn btn-ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
      </div>
    </div>

    <div class="hero-prod" id="heroProd">
      <div class="hstage" id="hstage">
        <div class="hslide hs1 on" data-n="1"><span class="hp p-kbtl a d1" role="img" aria-label="{{ p1.title | default: 'Purelane cleaner bottle' }}"></span><div class="glass-2 ptag"><span class="lbl">Single bottle</span><span class="val"><strong>{% if p1 != blank %}{{ p1.price | money_without_trailing_zeros }}{% else %}&#8377;200{% endif %}</strong>{% if p1 != blank and p1.compare_at_price > p1.price %}<s>{{ p1.compare_at_price | money_without_trailing_zeros }}</s>{% else %}<s>&#8377;299</s>{% endif %}</span><span class="cut">33% off</span></div></div>
        <div class="hslide hs2" data-n="2"><span class="hp p-tbtl a d1" role="img" aria-label="{{ p2.title | default: 'Purelane cleaner bottle' }}"></span><span class="hp p-kbtl b d2" role="img" aria-label="{{ p1.title | default: 'Purelane cleaner bottle' }}"></span><div class="glass-2 ptag"><span class="lbl">Any 2 products</span><span class="val"><strong>&#8377;349</strong><s>&#8377;598</s></span><span class="cut">Save &#8377;249</span></div></div>
        <div class="hslide hs3" data-n="3"><span class="hp p-tbtl a d1" role="img" aria-label="{{ p2.title | default: 'Purelane cleaner bottle' }}"></span><span class="hp p-mbtl b d2" role="img" aria-label="{{ p3.title | default: 'Purelane cleaner bottle' }}"></span><span class="hp p-kbtl c d3" role="img" aria-label="{{ p1.title | default: 'Purelane cleaner bottle' }}"></span><div class="glass-2 ptag"><span class="lbl">Any 3 products</span><span class="val"><strong>&#8377;499</strong><s>&#8377;897</s></span><span class="cut">Save &#8377;398</span></div></div>
      </div>
      <div class="hdots" id="hdots"><button type="button" class="on" aria-label="Show 1 product"></button><button type="button" aria-label="Show 2 products"></button><button type="button" aria-label="Show 3 products"></button></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Clean\nThat" },
    { "type": "text", "id": "accent_heading", "label": "Accent heading", "default": "Lasts" },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it." },
    { "type": "product_list", "id": "products", "label": "Featured products", "limit": 3 },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Shop now" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "How it works" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "blocks": [
    { "type": "promise", "name": "Promise", "settings": [{ "type": "text", "id": "icon", "label": "Icon", "default": "leaf" }, { "type": "text", "id": "text", "label": "Text", "default": "Plant powered" }] }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Purelane hero", "blocks": [{ "type": "promise" }, { "type": "promise", "settings": { "icon": "shield", "text": "Safe for kids & pets" } }, { "type": "promise", "settings": { "icon": "clean", "text": "Zero harsh chemicals" } }] }]
}
{% endschema %}
