{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section class="pl-section pl-combos" id="combos" data-scene="3">
  <div class="pl-shell">
    <header class="pl-combos__head pl-reveal">
      <span class="pl-kicker">{{ section.settings.kicker | escape }}</span><h2 class="pl-heading">{{ section.settings.heading | escape }}</h2>
      <div class="pl-leaf-rule"><i></i><span>♧</span><i></i></div><p class="pl-copy">{{ section.settings.copy | escape }}</p>
    </header>

    <div class="pl-rail">
      {% for block in section.blocks %}
        {% assign bundle = block.settings.bundle_product %}
        <article class="pl-combo" {{ block.shopify_attributes }}>
          <div class="pl-combo__media">
            {% for i in (1..3) %}
              {% assign product_key = 'product_' | append: i %}
              {% assign included_product = block.settings[product_key] %}
              {% if included_product.featured_image %}{{ included_product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', alt: included_product.title }}{% endif %}
            {% endfor %}
            {% if block.settings.product_1 == blank %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
          </div>
          <div class="pl-combo__body">
            {% if block.settings.badge != blank %}<span class="pl-kicker">{{ block.settings.badge | escape }}</span>{% endif %}
            <h3>{% if block.settings.heading != blank %}{{ block.settings.heading | escape }}{% else %}{{ bundle.title | escape }}{% endif %}</h3>
            <span class="pl-combo__products">{% if block.settings.product_3 != blank %}3 products{% elsif block.settings.product_2 != blank %}2 products{% else %}Curated set{% endif %}</span>
            <p>{{ block.settings.copy | escape }}</p>
            {% if bundle != blank %}<div class="pl-price"><strong>{{ bundle.price | money }}</strong>{% if bundle.compare_at_price > bundle.price %}<s>{{ bundle.compare_at_price | money }}</s>{% endif %}</div><a class="pl-button pl-button--outline" href="{{ bundle.url }}">Shop bundle</a>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
    <p class="pl-swipe-cue">→ Swipe for more combos</p><p class="pl-rail-note">Tapping “Shop bundle” opens the bundle with these products ready to buy.</p>
  </div>
</section>

{% schema %}
{
  "name": "Purelane combos",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." }
  ],
  "blocks": [{
    "type": "combo", "name": "Combo", "settings": [
      { "type": "product", "id": "bundle_product", "label": "Purchasable bundle product" },
      { "type": "product", "id": "product_1", "label": "Included product 1" },
      { "type": "product", "id": "product_2", "label": "Included product 2" },
      { "type": "product", "id": "product_3", "label": "Included product 3" },
      { "type": "text", "id": "heading", "label": "Fallback heading", "default": "Kitchen essentials" },
      { "type": "textarea", "id": "copy", "label": "Description", "default": "Everything needed for a sparkling room, selected as one easy set." },
      { "type": "text", "id": "badge", "label": "Badge", "default": "Most popular" }
    ]
  }],
  "max_blocks": 6,
  "presets": [{ "name": "Purelane combos", "blocks": [{ "type": "combo" }, { "type": "combo", "settings": { "heading": "Laundry care bundle", "badge": "Fresh favourite" } }, { "type": "combo", "settings": { "heading": "Complete home bundle", "badge": "Best value" } }] }]
}
{% endschema %}
