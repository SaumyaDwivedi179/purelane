{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section class="pl-section pl-combos" id="combos" data-scene="3">
  <div class="pl-shell">
    <header class="pl-combos__head pl-reveal">
      <span class="pl-kicker">{{ section.settings.kicker | escape }}</span><h2 class="pl-heading">{{ section.settings.heading | escape }}</h2>
      <div class="pl-leaf-rule"><i></i><span>♧</span><i></i></div><p class="pl-copy">{{ section.settings.copy | escape }}</p>
    </header>

    <div class="pl-rail">
      {% for block in section.blocks %}
        {% assign bundle = block.settings.bundle_product %}
        <article class="pl-combo{% if block.settings.featured %} is-featured{% endif %}" {{ block.shopify_attributes }}>
          <div class="pl-combo__media">
            {% if block.settings.saving_label != blank %}<span class="pl-combo__saving">{{ block.settings.saving_label | escape }}</span>{% endif %}
            {% if block.settings.flag != blank %}<span class="pl-combo__flag">{{ block.settings.flag | escape }}</span>{% endif %}
            {% for i in (1..3) %}
              {% assign product_key = 'product_' | append: i %}
              {% assign art_key = 'art_' | append: i %}
              {% assign label_key = 'item_' | append: i | append: '_label' %}
              {% assign included_product = block.settings[product_key] %}
              {% if included_product != blank or block.settings[art_key] != 'product' %}{% if i > 1 %}<b class="pl-combo__plus" aria-hidden="true">+</b>{% endif %}<span class="pl-combo__item">{% if block.settings[art_key] == 'product' %}{% render 'purelane-product-art', product: included_product %}{% else %}{% render 'purelane-product-art', kind: block.settings[art_key] %}{% endif %}<small>{{ block.settings[label_key] | default: included_product.title | escape }}</small></span>{% endif %}
            {% endfor %}
            {% if block.settings.product_1 == blank %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
          </div>
          <div class="pl-combo__body">
            <h3>{% if block.settings.heading != blank %}{{ block.settings.heading | escape }}{% else %}{{ bundle.title | escape }}{% endif %}</h3>
            <span class="pl-combo__products">{{ block.settings.product_count }} products</span>
            <p>{{ block.settings.copy | escape }}</p>
            {% if bundle != blank %}<div class="pl-price"><strong>&#8377;{{ bundle.price | money_without_currency | replace: '.00', '' }}</strong>{% if bundle.compare_at_price > bundle.price %}<s>&#8377;{{ bundle.compare_at_price | money_without_currency | replace: '.00', '' }}</s><em>Save &#8377;{{ bundle.compare_at_price | minus: bundle.price | money_without_currency | replace: '.00', '' }}</em>{% endif %}</div><small class="pl-combo__fine">Inclusive of all taxes &middot; COD available</small><a class="pl-button {% if block.settings.featured %}pl-button--primary{% else %}pl-button--outline{% endif %}" href="{{ bundle.url }}">Shop bundle &rarr;</a>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
    <p class="pl-swipe-cue">&rarr; Swipe for more combos</p><p class="pl-rail-note">Tapping &ldquo;Shop bundle&rdquo; opens the bundle picker with these products already added. You can still swap anything before you pay.</p>
  </div>
</section>

{% schema %}
{
  "name": "Purelane combos",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." }
  ],
  "blocks": [{
    "type": "combo", "name": "Combo", "settings": [
      { "type": "product", "id": "bundle_product", "label": "Purchasable bundle product" },
      { "type": "product", "id": "product_1", "label": "Included product 1" },
      { "type": "product", "id": "product_2", "label": "Included product 2" },
      { "type": "product", "id": "product_3", "label": "Included product 3" },
      { "type": "select", "id": "art_1", "label": "Art 1", "options": [{ "value": "product", "label": "Product" }, { "value": "dish", "label": "Dishwash" }, { "value": "leaf", "label": "Leaf tile" }, { "value": "eraser", "label": "Magic eraser" }], "default": "product" },
      { "type": "select", "id": "art_2", "label": "Art 2", "options": [{ "value": "product", "label": "Product" }, { "value": "dish", "label": "Dishwash" }, { "value": "leaf", "label": "Leaf tile" }, { "value": "eraser", "label": "Magic eraser" }], "default": "product" },
      { "type": "select", "id": "art_3", "label": "Art 3", "options": [{ "value": "product", "label": "Product" }, { "value": "dish", "label": "Dishwash" }, { "value": "leaf", "label": "Leaf tile" }, { "value": "eraser", "label": "Magic eraser" }], "default": "product" },
      { "type": "text", "id": "item_1_label", "label": "Item 1 caption" },
      { "type": "text", "id": "item_2_label", "label": "Item 2 caption" },
      { "type": "text", "id": "item_3_label", "label": "Item 3 caption" },
      { "type": "range", "id": "product_count", "label": "Product count", "min": 1, "max": 10, "step": 1, "default": 3 },
      { "type": "text", "id": "heading", "label": "Fallback heading", "default": "Kitchen essentials" },
      { "type": "textarea", "id": "copy", "label": "Description", "default": "Everything needed for a sparkling room, selected as one easy set." },
      { "type": "text", "id": "saving_label", "label": "Saving label", "default": "You save ₹398" },
      { "type": "text", "id": "flag", "label": "Corner flag" },
      { "type": "checkbox", "id": "featured", "label": "Featured card", "default": false }
    ]
  }],
  "max_blocks": 6,
  "presets": [{ "name": "Purelane combos", "blocks": [{ "type": "combo" }, { "type": "combo", "settings": { "heading": "Laundry care bundle", "saving_label": "You save ₹448" } }, { "type": "combo", "settings": { "heading": "Complete home bundle", "saving_label": "Biggest saving", "flag": "Best value", "featured": true } }] }]
}
{% endschema %}
