{{ 'purelane.css' | asset_url | stylesheet_tag }}

<footer class="pl-footer" data-scene="4">
  <div class="pl-shell">
    <div class="pl-footer__grid">
      <div><a class="pl-brand" href="#top"><span class="pl-brand__mark">♧</span><span><b>Purelane</b><small>Clean, simply</small></span></a><p>{{ section.settings.copy | escape }}</p></div>
      <nav aria-label="Shop links"><h2>Shop</h2><a href="#shop">Bestsellers</a><a href="#shop">Kitchen</a><a href="#shop">Laundry</a><a href="#shop">Home</a><a href="#shop">Skin</a><a href="#bundles">Starter kits</a></nav>
      <nav aria-label="About links"><h2>About</h2><a href="#how">How it works</a><a href="#ingredients">Sustainability</a><a href="#proof">FAQs</a><a href="#reviews">Reviews</a></nav>
      <div><h2>Get in touch</h2><a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a><a href="tel:{{ section.settings.phone | remove: ' ' | escape }}">{{ section.settings.phone | escape }}</a><p>Purelane Eco Products Pvt Ltd</p></div>
    </div>
    <div class="pl-footer__bottom"><span>© {{ 'now' | date: '%Y' }} Purelane Eco Products Private Limited</span><span>Privacy · Terms · Refunds · Contact</span></div>
  </div>
</footer>
<div class="pl-mobile-cta"><span><b>Pick any 3, pay ₹499</b><small>Free shipping, always</small></span><a class="pl-button pl-button--primary" href="#bundles">Build bundle</a></div>

{% schema %}
{
  "name": "Purelane footer",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "textarea", "id": "copy", "label": "Brand copy", "default": "Effective cleaning, powered by nature. Made for Indian homes since day one." },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@purelane.com" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+91 9930 123 234" }
  ],
  "presets": [{ "name": "Purelane footer" }]
}
{% endschema %}
