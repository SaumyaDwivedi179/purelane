{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section class="pl-section pl-after-shop" data-scene="4" data-pl-depth="4">
  <div class="pl-shell">
    <div class="pl-range pl-glass pl-reveal"><div><span class="pl-kicker">The full range</span><h2 class="pl-heading">Every room, one shelf</h2></div><p class="pl-copy">Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink.</p><div class="pl-range__products">{% render 'purelane-product-art', kind: 'floor' %}{% render 'purelane-product-art', kind: 'tap' %}{% render 'purelane-product-art', kind: 'kitchen' %}{% render 'purelane-product-art', kind: 'toilet' %}{% render 'purelane-product-art', kind: 'laundry' %}{% render 'purelane-product-art', kind: 'dish' %}{% render 'purelane-product-art', kind: 'metal' %}{% render 'purelane-product-art', kind: 'wm' %}{% render 'purelane-product-art', kind: 'handwash' %}{% render 'purelane-product-art', kind: 'eraser' %}</div><small class="pl-range__swipe">Swipe to see the full shelf</small></div>
    <div class="pl-why pl-glass pl-reveal"><span class="pl-kicker">The smarter way to shop</span><h2 class="pl-heading">Why bundles beat buying single</h2><div class="pl-why__grid"><div><i>₹</i><b>Save up to 45%</b><span>Versus buying the same products separately</span></div><div><i>✓</i><b>One flat price</b><span>No calculators, no comparing carts</span></div><div><i>☆</i><b>Curated by experts</b><span>Products picked to work well together</span></div><div><i>▣</i><b>Free shipping always</b><span>Included on every bundle, all India</span></div></div></div>
    <div class="pl-categories"><header class="pl-after-shop__head"><span class="pl-kicker">Bundle categories</span><h2 class="pl-heading">Find the right bundle for you</h2></header>
    <div class="pl-category-grid">{% assign handles = 'foaming-kitchen-cleaner,non-toxic-toilet-cleaner,plant-based-laundry-detergent,tap-limescale-cleaner' | split: ',' %}{% assign labels = 'Kitchen bundle,Bathroom bundle,Laundry bundle,Hard water bundle' | split: ',' %}{% assign notes = 'Grease, dishes & more|Deep clean & disinfect|Softer, fresher wash|Melt away limescale' | split: '|' %}{% for handle in handles %}{% assign item = all_products[handle] %}<a class="pl-category pl-glass pl-reveal" href="{{ item.url | default: '#combos' }}">{% if item != blank and item.featured_image != blank %}{{ item.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', alt: item.title }}{% endif %}<b>{{ labels[forloop.index0] }}</b><span>{{ notes[forloop.index0] }}</span></a>{% endfor %}</div></div>
    <div class="pl-trust pl-glass"><span>♧ Plant derived formulas</span><span>▣ Recyclable packaging</span><span>♡ Safe for kids & pets</span><span>⊕ Made in India</span></div>
    <div class="pl-signup pl-glass pl-reveal"><span class="pl-kicker">Join the Purelane Club</span><h2 class="pl-heading">Get ₹100 off your first bundle</h2><p>Plus first access to new launches and restocks.</p>{% form 'customer', class: 'pl-signup__form' %}<input type="email" name="contact[email]" placeholder="your@email.com" aria-label="Email address" required><button class="pl-button pl-button--primary" type="submit">Get my ₹100 off</button>{% endform %}</div>
  </div>
</section>

{% schema %}
{ "name": "Purelane bundle guide", "tag": "section", "class": "section", "settings": [], "presets": [{ "name": "Purelane bundle guide" }] }
{% endschema %}
