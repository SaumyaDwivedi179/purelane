{% comment %}
  Product card shared by Purelane product, combo and bundle sections.
  Accepts: product, badge, benefit, eager, section_id
{% endcomment %}

<article class="pl-product-card{% unless product.available %} is-sold-out{% endunless %}">
  <a class="pl-product-card__media" href="{{ product.url }}">
    {% if badge != blank %}<span class="pl-pill">{{ badge | escape }}</span>{% endif %}
    {% render 'purelane-product-art', product: product %}
  </a>

  <div class="pl-product-card__body">
    <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
    <div class="pl-card-rate"><b>&#9733; 4.8</b><span>&middot; {{ product.metafields.custom.review_count.value | default: 237 }} reviews</span></div>
    {% if benefit != blank %}<p>{{ benefit | escape }}</p>{% endif %}
    <div class="pl-price">
      <strong>&#8377;{{ product.price | money_without_currency | replace: '.00', '' }}</strong>
      {% if product.compare_at_price > product.price %}<s>&#8377;{{ product.compare_at_price | money_without_currency | replace: '.00', '' }}</s><em>{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}% off</em>{% endif %}
    </div>

    {% assign form_id = 'pl-add-' | append: section_id | append: '-' | append: product.id %}
    <product-form data-section-id="{{ section_id }}">
      {% form 'product', product, id: form_id, class: 'pl-product-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" {% unless product.available %}disabled{% endunless %}>
        <button class="pl-button pl-button--outline" type="submit" name="add" {% unless product.available %}disabled{% endunless %}>
          <span>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</span>
          {% render 'loading-spinner' %}
        </button>
      {% endform %}
    </product-form>
  </div>
</article>
